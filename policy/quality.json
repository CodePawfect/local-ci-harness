{
  "schema_version": 1,
  "required_stages": ["secrets", "static-analysis", "tests", "coverage", "build"],
  "adapter_required_stages": {
    "next-npm": ["dependencies", "lint-typecheck"],
    "next-fullstack": ["dependencies", "lint-typecheck"],
    "spring-maven": ["dependencies"],
    "generic": [],
    "custom": []
  },
  "coverage_min": {"lines": 70, "branches": 60},
